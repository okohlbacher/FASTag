+    /// DirecTag InitCEBins(): SSE of c uniform(-tol, tol) errors about their mean, 10000 draws,
+    /// value = (number of draws <= sse, at least 1) / (draws + 1). Built per thread, fixed seed.
+    static double diagCeQ(int c, double tol, double sse)
+    {
+      static thread_local std::vector<std::vector<double>> nulls;
+      static thread_local double ntol = -1;
+      if (ntol != tol) { nulls.clear(); ntol = tol; }
+      if (nulls.size() <= static_cast<size_t>(c)) nulls.resize(static_cast<size_t>(c) + 1);
+      std::vector<double>& v = nulls[static_cast<size_t>(c)];
+      if (v.empty())
+      {
+        std::mt19937 rng(0);
+        std::uniform_real_distribution<double> U(-tol, tol);
+        std::vector<double> e(static_cast<size_t>(c));
+        for (int i = 0; i < 10000; ++i)
+        {
+          double m = 0;
+          for (auto& x : e) { x = U(rng); m += x; }
+          m /= c;
+          double q = 0;
+          for (double x : e) q += (x - m) * (x - m);
+          v.push_back(q);
+        }
+        std::sort(v.begin(), v.end());
+      }
+      const double n = static_cast<double>(std::upper_bound(v.begin(), v.end(), sse) - v.begin());
+      return std::max(1.0, n) / (static_cast<double>(v.size()) + 1.0);
+    }
