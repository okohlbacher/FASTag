{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window: the core and plugin permissions, and every app command but the feedback ones (src/app_commands.rs)",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-probe",
    "allow-example-input",
    "allow-cli-capabilities",
    "allow-probe-input",
    "allow-run",
    "allow-cancel",
    "allow-outputs-check",
    "allow-command-line",
    "allow-export-ini",
    "allow-history-list",
    "allow-history-of",
    "allow-history-delete",
    "allow-history-rerun",
    "allow-reveal-output",
    "allow-set-ui-busy",
    "allow-close-answer",
    "allow-notify-finished",
    "allow-results-open",
    "allow-results-query",
    "allow-results-position",
    "allow-results-export",
    "allow-results-cancel",
    "allow-report-text",
    "allow-report-head",
    "allow-summary-write",
    "allow-sdrf-read",
    "allow-taxonomy-dump",
    "allow-denovo-export",
    "allow-folder-spectra-list",
    "allow-path-status",
    "allow-taxdb-info",
    "allow-taxonomy-status",
    "allow-spectrum-support",
    "allow-spectrum-peaks",
    "allow-load-settings",
    "allow-save-last",
    "allow-save-preset",
    "allow-delete-preset",
    "allow-leftovers-list",
    "allow-leftovers-sweep",
    "allow-leftovers-keep",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.ncbi.nlm.nih.gov/Taxonomy/*"
        }
      ]
    },
    "dialog:default"
  ]
}
