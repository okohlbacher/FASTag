# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Synthetic report fixtures (the repo ignores *.tsv)
!src/fixtures/*.tsv

# The Playwright e2e build and its results (e2e-web/)
dist-e2e
e2e-web/test-results
e2e-web/playwright-report
e2e-web/screens
e2e-web/test-results-screens
# ...but its fixtures are source
!e2e-web/fixtures/*.tsv
# ...and the real-CLI fixtures (gui/src/fixtures/cli/<case>/): their .tsv and
# .log files are source too
!src/fixtures/cli/**/*.tsv
!src/fixtures/cli/**/*.log
# ...and the de novo inputs (gui/src/fixtures/denovo/), the golden files' sources
!src/fixtures/denovo/*.tsv
# The tauri-driver specs' recorded gates and logs (e2e-tauri/run.sh)
e2e-tauri/results
# The committed real CLI outputs (the repository ignores *.tsv)
!src/fixtures/real/**/*.tsv
# ...and the recorded 1.15 CLI outputs (gui/src/fixtures/cli-1.15/)
!src/fixtures/cli-1.15/**/*.tsv
# ...and the development CLI outputs the tests read (gui/src/fixtures/cli-dev/README.md)
!src/fixtures/cli-dev/**/*.tsv
# ...and the 1.12 CLI outputs and SDRF fixtures (tracked since before these
# rules; listed so re-adding them needs no -f)
!src/fixtures/cli-1.12/*.tsv
!src/fixtures/sdrf/*.tsv
# ...and the recorded 1.16 CLI outputs (gui/src/fixtures/cli-1.16/README.md)
!src/fixtures/cli-1.16/**/*.tsv
