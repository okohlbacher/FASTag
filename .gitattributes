# Byte-exact inputs: no CRLF conversion on a Windows checkout. The tests read
# indexed mzML fixtures (byte offsets), compare outputs with stored sha256s
# and check byte lengths; the shipped tables are read as LF text.
test/fixtures/** -text
data/** -text

# Frozen benchmark bytes participate in the provenance hashes. Empty final TSV
# fields and csv.DictWriter's CRLF records are intentional, not formatting bugs.
bench/results/tmt-ga-2026-11-11/** -text
bench/results/tmt-ga-2026-11-11/summary.tsv whitespace=cr-at-eol
bench/results/tmt-ga-2026-11-11/audit/engine_disagreements.tsv whitespace=-blank-at-eol
bench/results/tmt-ga-2026-11-11/audit/failure_quality_strata.tsv whitespace=-blank-at-eol
