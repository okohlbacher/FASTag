build/
*.o
*.tsv
*.mzML
*.mgf
*.tags
build-mzpeak/
build-diag/
build-inst/
build-f4/
build-main/
build-rel/

# local dev symlinks to a taxonomy index (see data/taxonomy/README.md)
/share/

# ...but the species reference-set manifest is source, not a test output
!data/taxonomy/reference-set.tsv
# ...and so are the frozen -species_call decoy parameters (1.12 #1)
!data/taxonomy/species_call.tsv
__pycache__/

# Test fixtures are the one place data files belong in the repo.
!test/fixtures/*.mzML
!test/fixtures/*.mgf
!test/fixtures/*.tsv
!data/digest/*.tsv
# ...and the gate reference sets' run tables (gate.sh --refs writes cases.tsv, results.tsv)
!tools/gate-1.12/refs-*/*.tsv
